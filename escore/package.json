{
  "name": "escore",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"!server/node_modules/**\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"server/**/*.js\" \"!server/node_modules/**\"",
    "test": "vitest run && node --test \"server/test/*.test.js\"",
    "test:web": "vitest run",
    "test:server": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.29.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
