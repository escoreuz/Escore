# eSCORE backend (escore/server) — muhit o'zgaruvchilari namunasi.
# Lokal: bu faylni `.env` ga nusxalang (git'ga tushmaydi) va `node --env-file=.env index.js` bilan ishga tushiring.
# Render'da qiymatlar render.yaml / dashboard → Environment orqali beriladi. HAQIQIY SECRET BU YERGA YOZILMAYDI.

# HTTP port. Render o'zi beradi; lokal default 4500.
PORT=4500

# production — so'rov logida faqat 5xx yoziladi. Lokal: development.
NODE_ENV=development

# 0 — DEMO rejim (uydirma ma'lumot, faqat lokal ishlab chiqish). Boshqa qiymat yoki bo'sh — REAL (default).
USE_REAL=1

# FastAPI (sofascore-api) manzili. Protokolsiz bo'lsa https:// qo'shiladi. Default http://localhost:8000.
SCORE_API=http://localhost:8000

# SofaScore proksisiga so'rov timeouti, ms (butun son 1..60000). Noto'g'ri bo'lsa default 10000.
SOFA_TIMEOUT_MS=10000

# CORS ruxsat etilgan originlar, vergul bilan (oxirida `/` siz). Default http://localhost:5190.
# Production: https://escore-web.onrender.com,https://sizningdomen.uz,https://www.sizningdomen.uz
ALLOWED_ORIGINS=http://localhost:5190

# Sayt manzili: sitemap.xml va /share/news/:slug havolalari. Faqat http(s), aks holda server ishga tushmaydi.
# Default http://localhost:5190.
SITE_URL=http://localhost:5190

# POST/PUT/DELETE /api/news uchun `Authorization: Bearer <token>`. Kamida 16 belgi.
# Bo'sh yoki qisqa bo'lsa yozish endpointlari o'chiq (403). Yaratish:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# news.json va archive.json papkasi (doimiy disk ulanganda). Bo'sh — server/db.
ESCORE_DATA_DIR=
