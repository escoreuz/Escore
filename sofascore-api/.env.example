# Manba (odatda o'zgartirilmaydi)
SOFASCORE_BASE=https://api.sofascore.com/api/v1
SOFASCORE_IMG_BASE=https://api.sofascore.app/api/v1

# HTTP
REQUEST_TIMEOUT=15
MAX_RETRIES=3

# curl_cffi TLS profili. 403 "challenge" olsangiz boshqasini sinang:
# chrome120, chrome123, chrome124, chrome131
IMPERSONATE=chrome124

# Kesh TTL (sekund)
CACHE_TTL_LIVE=8
CACHE_TTL_SHORT=60
CACHE_TTL_LONG=3600
CACHE_TTL_IMAGE=86400

# SofaScore bloklasa — proksi qo'ying (masalan: http://user:pass@host:port)
# PROXY_URL=
